# ---- Secrets & env ----
.env
*.env.local
*.pem
# Secrets: nothing under a secrets/ folder is committed, encrypted or not — it's mounted at runtime
# (docs/SECRETS.md). Scoped to secrets/ (any depth) + the canonical name: other *.enc files (e.g. test
# fixtures) stay committable.
**/secrets/
secrets.enc
# Per-service compose overrides (docker-compose.yml: config/<service>.env)
config/*.env
secrets.plain.json
*.plain.json
*.key
*.enc.tmp
master.key
*.masterkey

# ---- .NET ----
bin/
obj/
*.user
*.suo
.vs/
artifacts/
[Dd]ebug/
[Rr]elease/
TestResults/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# ---- ML artifacts ----
models/*.pt
models/*.ckpt
checkpoints/
*.onnx
data/raw/
data/processed/
mlruns/
wandb/

# ---- Docker / DB ----
pgdata/
*.log

# ---- IDE / OS ----
.idea/
.DS_Store
Thumbs.db
*.swp
