# ============================================================
# Solia — environment template. Copy to .env and fill values.
# Never commit .env (it is gitignored).
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=solia
POSTGRES_PASSWORD=change_me
POSTGRES_DB=solia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Data source (PumpPortal) ----
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Optional Solana RPC for enrichment (Helius/QuickNode/etc.)
SOLANA_RPC_URL=

# ---- AI service ----
AI_SERVICE_URL=http://ai-service:8000
MODEL_DIR=/app/models
RETRAIN_EVERY_N_TRADES=500

# ---- Backend (.NET) ----
ASPNETCORE_ENVIRONMENT=Development
BACKEND_URL=http://backend:8080

# ---- Secrets (AES) ----
# Master key used to decrypt secrets/secrets.enc at runtime.
# In production, inject this via the host env / a secret manager — NOT the file.
SOLIA_MASTER_KEY=

# ---- Paper trading bot ----
PAPER_STARTING_BALANCE=10
PAPER_MAX_CONCURRENT_POSITIONS=5
