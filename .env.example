# ============================================================
# Solia — environment template. Copy to .env and fill values.
# Never commit .env (it is gitignored).
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=solia
POSTGRES_PASSWORD=change_me
POSTGRES_DB=solia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Data source (pumpapi.io — primary) ----
PUMPAPI_WS_URL=wss://stream.pumpapi.io/
PUMPAPI_REPLAY_BASE_URL=https://replay.pumpapi.io
# Approximate holders from unique traders (free) vs paid Get Token Info. Default off (free).
ENRICH_HOLDERS=false

# ---- Data pipeline mode (mutually exclusive: each owns the single live connection) ----
# Persist the live stream to PostgreSQL. Compose defaults it to true; a bare `dotnet run` to false.
INGEST=true
# Log live events without persisting (debug). Must be false when INGEST=true.
STREAM_PROBE=false

# ---- Data source fallbacks (optional) ----
# PumpPortal: trade stream is metered (0.01 SOL / 10k trades) — alternative only.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Solana RPC for the autonomous logsSubscribe+IDL fallback (Helius/QuickNode/public).
SOLANA_RPC_WS_URL=
SOLANA_RPC_HTTP_URL=

# ---- AI service ----
AI_SERVICE_URL=http://ai-service:8000
MODEL_DIR=/app/models
RETRAIN_EVERY_N_TRADES=500

# ---- Backend (.NET) ----
# Local `dotnet run` only (launchSettings.json already sets Development); compose pins the
# containers to Production regardless of this value.
ASPNETCORE_ENVIRONMENT=Development
BACKEND_URL=http://backend:8080

# ---- Secrets (AES) ----
# Master key used to decrypt secrets/secrets.enc at runtime.
# In production, inject this via the host env / a secret manager — NOT the file.
SOLIA_MASTER_KEY=
# Encrypted secrets file (default secrets/secrets.enc, relative to the working directory).
# SOLIA_SECRETS_FILE=secrets/secrets.enc

# ---- Paper trading bot ----
# Run the bot inside the backend (needs the data-pipeline feed and the ai-service).
PAPER_BOT_ENABLED=false
PAPER_STARTING_BALANCE=10
PAPER_MAX_CONCURRENT_POSITIONS=5
