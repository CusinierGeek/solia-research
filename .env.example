# ============================================================
# Solia — environment template. Works as-is for the whole stack:
#
#   cp .env.example .env && docker compose up -d --build
#
# Never commit .env (gitignored, dockerignored).
#
# How compose uses it: interpolation. docker-compose.yml lists, per service, exactly the variables
# that service reads, so a key reaches only the containers that need it. A key added here that
# docker-compose.yml doesn't list reaches NO container: for anything else (nested .NET keys such as
# Logging__LogLevel__Default, Bot__*, Pipeline__*), use the optional, gitignored config/<service>.env
# (e.g. config/backend.env), loaded by that one service. Host env vars win over .env.
# Container hosts/ports/paths (POSTGRES_HOST=postgres, AI_SERVICE_URL, BACKEND_URL, MODEL_DIR,
# ASPNETCORE_ENVIRONMENT=Production) are pinned in compose.
#
# Local runs: `dotnet run` / pytest do NOT load this file. Export it into your shell first
# (bash: `set -a; . ./.env; set +a`) so local runs use the same values as the containers
# (e.g. POSTGRES_PASSWORD); unexported, they fall back to built-in defaults.
#
# [compose]   read by the containers (via docker-compose.yml) — and by local runs once exported.
# [local dev] for local runs only (once exported); compose ignores it and pins its own value.
# ============================================================

# ---- PostgreSQL ----
# [compose] credentials for the postgres container and every service that connects to it. This is
# the one source of the DB password for the containers: postgres and the Python/pipeline services
# don't read secrets.enc (docs/SECRETS.md). In production inject it from the host env.
POSTGRES_USER=solia
POSTGRES_PASSWORD=change_me
POSTGRES_DB=solia
# [local dev] compose pins postgres:5432. For `dotnet run` against the dev override, use localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# [local dev] full connection string; wins over POSTGRES_* when set. Compose blanks it.
# SOLIA_DB_CONNECTION=Host=localhost;Port=5432;Database=solia;Username=solia;Password=change_me

# ---- Data source (pumpapi.io — primary) → data-pipeline ----
# [compose]
PUMPAPI_WS_URL=wss://stream.pumpapi.io/
PUMPAPI_REPLAY_BASE_URL=https://replay.pumpapi.io
# Approximate holders from unique traders (free) vs paid Get Token Info. Default off (free).
ENRICH_HOLDERS=false

# ---- Data pipeline mode (mutually exclusive: each owns the single live connection) ----
# [compose] persist the live stream to PostgreSQL. Compose defaults it to true; a bare `dotnet run`
# to false. Set false to run the containerized pipeline idle (no pumpapi traffic).
INGEST=true
# [compose] log live events without persisting (debug). Must be false when INGEST=true.
STREAM_PROBE=false

# ---- Data retention → data-pipeline (docs/DATA-PIPELINE.md § Data retention) ----
# [compose] periodic purge of old rows. Compose defaults it to true; a bare `dotnet run` to false.
# Also refuses a replay of a window older than the features TTL (it would be purged).
RETENTION_ENABLED=true
# [compose] minutes between two purges (1-1440); the first runs at startup.
RETENTION_INTERVAL_MINUTES=60
# [compose] days kept (1-3650). features bounds what a retrain reads: keep it above what training needs.
RETENTION_FEATURES_TTL_DAYS=14
RETENTION_LOGS_TTL_DAYS=14
RETENTION_PREDICTIONS_TTL_DAYS=30
# [compose] rows deleted per statement / short transaction (100-1000000).
RETENTION_BATCH_SIZE=10000

# ---- Data source fallbacks (not read by any service yet — future swappable DataSource) ----
# PumpPortal: trade stream is metered (0.01 SOL / 10k trades) — alternative only.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Solana RPC for the autonomous logsSubscribe+IDL fallback (Helius/QuickNode/public).
SOLANA_RPC_WS_URL=
SOLANA_RPC_HTTP_URL=

# ---- AI service ----
# [local dev] compose pins http://ai-service:8000 (backend) and /app/models (the models volume).
AI_SERVICE_URL=http://localhost:8000
# MODEL_DIR=   (unset ⇒ the ai-service's built-in default directory)
# [compose] → ai-service: model/training config file. Empty ⇒ the packaged config.yaml. In the
# container, point it at a file in the models volume (e.g. /app/models/config.yaml).
SOLIA_AI_CONFIG=
# [compose] → ai-service + backend: retrain every N closed paper trades.
RETRAIN_EVERY_N_TRADES=500
# [compose] → ai-service: the background retrain trigger. Left unset here so each default applies:
# on in compose, off in a bare local run (uvicorn), which then retrains only on demand
# (POST /model/retrain). Set true/false to force it either way.
# RETRAIN_SCHEDULER_ENABLED=
# [compose] → ai-service: seconds between two checks of the closed-trade counter (> 0).
RETRAIN_CHECK_INTERVAL_SECONDS=300
# [compose] NVIDIA GPU host: train on CUDA by default (docker-compose.gpu.yml, see the ai-service README).
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# COMPOSE_PATH_SEPARATOR=:

# ---- Backend / dashboard (.NET) ----
# [local dev] launchSettings.json already sets Development; compose pins Production.
ASPNETCORE_ENVIRONMENT=Development
# [local dev] backend URL for the dashboard (and the backend's OpenAPI server entry). Compose pins
# http://backend:8080 for the dashboard; the backend container keeps its default http://localhost:8080.
BACKEND_URL=http://localhost:8080

# ---- Secrets (AES-256-GCM, docs/SECRETS.md) ----
# [compose] → backend ONLY. Master key (base64, 32 bytes) that decrypts secrets/secrets.enc at runtime.
# Empty + no secrets/secrets.enc ⇒ plaintext config. A secrets.enc with an empty/wrong key ⇒ the
# backend exits non-zero. In production inject it from the host env / a secret manager, not this file.
SOLIA_MASTER_KEY=
# [local dev] encrypted file path (default secrets/secrets.enc, relative to the working directory).
# Compose mounts ./secrets read-only at /app/secrets and uses the default path.
# SOLIA_SECRETS_FILE=../../secrets/secrets.enc

# ---- Paper trading bot → backend ----
# [compose] run the bot inside the backend (needs the data-pipeline feed and the ai-service).
PAPER_BOT_ENABLED=false
PAPER_STARTING_BALANCE=10
PAPER_MAX_CONCURRENT_POSITIONS=5
