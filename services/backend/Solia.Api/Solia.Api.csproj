<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Solia.Shared\Solia.Shared.csproj" />
    <ProjectReference Include="..\Solia.Bot\Solia.Bot.csproj" />
    <ProjectReference Include="..\Solia.Core\Solia.Core.csproj" />
    <ProjectReference Include="..\Solia.Secrets\Solia.Secrets.csproj" />
  </ItemGroup>

  <!-- Local-dev overrides only: never published, so a container never picks up Development config. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Solia.Api.Tests" />
  </ItemGroup>

</Project>
