{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Pipeline": {
    "SnapshotCadenceSeconds": 10,
    "WindowSeconds": 300,
    "MaxTrackedTokens": 5000,
    "EnrichHolders": false
  },
  "PumpApi": {
    "WsUrl": "wss://stream.pumpapi.io/",
    "ReplayBaseUrl": "https://replay.pumpapi.io"
  }
}
