<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- _framework/blazor.web.js ships in the implicit Microsoft.AspNetCore.App.Internal.Assets package, which the SDK
         only restores when it sees .razor files. The Docker image restores from the .csproj alone (cached layer), so
         without this the published image would 404 the Blazor script and no circuit could start. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Solia.Shared\Solia.Shared.csproj" />
  </ItemGroup>

  <!-- Local-dev overrides only: never published, so a container never picks up Development config. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Solia.Dashboard.Tests" />
  </ItemGroup>

</Project>
