@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="SoliaTheme.Theme" @bind-IsDarkMode="_darkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Toggle navigation" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">Solia</MudText>
        <PaperTradingBadge Class="ml-4" />
        <LiveFeedIndicator Class="ml-2" />
        <MudSpacer />
        <MudIconButton Icon="@(_darkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                       Color="Color.Inherit" aria-label="Toggle dark mode" OnClick="ToggleDarkMode" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            <CascadingValue Value="_timeZone">
                @Body
            </CascadingValue>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _darkMode = true;

    // UTC until the browser tells its zone; every view reads it as a cascading TimeZoneInfo.
    private TimeZoneInfo _timeZone = TimeZoneInfo.Utc;

    internal bool IsDarkMode => _darkMode;

    internal TimeZoneInfo TimeZone => _timeZone;

    // The theme choice survives reloads and reconnects in the browser's localStorage (dark by default).
    internal const string DarkModeStorageKey = "solia-dark-mode";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        string? zoneId = null;
        try
        {
            zoneId = await JS.InvokeAsync<string?>(DisplayTimeZone.BrowserFunction);
        }
        catch (Exception ex) when (IsJsUnavailable(ex))
        {
        }
        TimeZoneInfo zone = DisplayTimeZone.Resolve(zoneId);
        if (zone.Id != _timeZone.Id)
        {
            _timeZone = zone;
            StateHasChanged();
        }
        string? stored = null;
        try
        {
            stored = await JS.InvokeAsync<string?>("localStorage.getItem", DarkModeStorageKey);
        }
        catch (Exception ex) when (IsJsUnavailable(ex))
        {
        }
        if (bool.TryParse(stored, out bool darkMode) && darkMode != _darkMode)
        {
            _darkMode = darkMode;
            StateHasChanged();
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleDarkMode()
    {
        _darkMode = !_darkMode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", DarkModeStorageKey, _darkMode ? "true" : "false");
        }
        catch (Exception ex) when (IsJsUnavailable(ex))
        {
        }
    }

    // Storage and the browser zone are niceties: blocked storage or a dropped circuit must not break the layout.
    private static bool IsJsUnavailable(Exception ex) => ex is JSException or JSDisconnectedException;
}
