@*
    The "load async → loading / empty / error / content" pattern every view adopts:

        <AsyncContent TItem="IReadOnlyList<Trade>" Load="Api.GetTradesAsync" IsEmpty="t => t.Count == 0"
                      EmptyMessage="No trades yet.">
            @foreach (var trade in context) { ... }
        </AsyncContent>

    Load runs once the component is interactive (never during prerendering, so a slow backend can't hold up the
    first paint), again when ReloadKey or the Load method changes, and on Retry or ReloadAsync(). A refresh keeps
    already-loaded content on screen until the new data arrives (no skeleton flicker on live updates). A reload
    cancels the previous attempt, and a stale attempt's outcome is discarded. Failures are logged and shown as
    ErrorState (never the exception text). With ShowRefreshing, a thin progress bar marks such a refresh. A failed
    refresh of the same data (same Load and ReloadKey: a live update, a resync, a reconcile tick, a retry) keeps the
    last content on screen under a StaleMessage warning (StaleState) with a retry, like the live views do; a failed
    load of different data (a new filter or page) is an ErrorState, since the old content would not answer it. While
    different data loads, the old content shows without that warning, which only ever describes the data asked for.

    Pass whatever the data depends on as ReloadKey: a lambda capturing a field compares equal across renders, so
    changing the field alone would not trigger a reload. The key must compare by value and never be mutated in place
    (a record of scalars, a tuple, a string…): a key changed in place still equals itself, so it neither reloads nor
    tells a failed load of the new data from a failed refresh of the old.

        <AsyncContent TItem="..." Load="ct => Api.GetHistoryAsync(_range, ct)" ReloadKey="_range" ...>
*@
@typeparam TItem
@implements IDisposable
@inject ILogger<AsyncContent<TItem>> Logger

@if (_refreshing)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" Class="solia-refreshing" />
}
@if (IsStale)
{
    <StaleState Class="mb-2" Message="@StaleMessage" OnRetry="ReloadAsync" />
}
@switch (State)
{
    case AsyncLoadState.Loading:
        @if (Loading is not null)
        {
            @Loading
        }
        else
        {
            <LoadingState Variant="LoadingVariant" />
        }
        break;
    case AsyncLoadState.Empty:
        <EmptyState Message="@EmptyMessage" />
        break;
    case AsyncLoadState.Error:
        <ErrorState Message="@ErrorMessage" OnRetry="ReloadAsync" />
        break;
    case AsyncLoadState.Invalid:
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="solia-invalid">
            <span class="solia-invalid__message">@_invalidMessage</span>
            @InvalidActions
        </MudAlert>
        break;
    default:
        @ChildContent(_value!)
        break;
}

@code {
    /// <summary>Fetches the data; receives a token cancelled on reload or when the component goes away.</summary>
    [Parameter, EditorRequired] public Func<CancellationToken, Task<TItem>> Load { get; set; } = default!;

    /// <summary>Renders the loaded value (available as <c>context</c>).</summary>
    [Parameter, EditorRequired] public RenderFragment<TItem> ChildContent { get; set; } = default!;

    /// <summary>Whether a loaded value counts as empty. A null value is always empty.</summary>
    [Parameter] public Func<TItem, bool>? IsEmpty { get; set; }

    [Parameter] public string EmptyMessage { get; set; } = "Nothing to show yet.";

    [Parameter] public string ErrorMessage { get; set; } = "Could not load data from the backend.";

    /// <summary>Shown above the last content when a refresh of the same data failed.</summary>
    [Parameter] public string StaleMessage { get; set; } = "Could not refresh from the backend; showing the last data received.";

    [Parameter] public LoadingVariant LoadingVariant { get; set; } = LoadingVariant.Skeleton;

    /// <summary>
    /// Recognises a failure caused by the request itself (e.g. a 400 <c>invalid_request</c>) and returns the message
    /// to show for it — inline, as a warning without a retry — or null for an ordinary error.
    /// </summary>
    [Parameter] public Func<Exception, string?>? InvalidMessage { get; set; }

    /// <summary>A way out of the invalid state (e.g. back to the first page), shown after its message.</summary>
    [Parameter] public RenderFragment? InvalidActions { get; set; }

    /// <summary>Marks a refresh of already-loaded content with a progress bar (off for live views refreshed in the background).</summary>
    [Parameter] public bool ShowRefreshing { get; set; }

    /// <summary>Replaces the default <see cref="LoadingState"/>.</summary>
    [Parameter] public RenderFragment? Loading { get; set; }

    /// <summary>
    /// What the data depends on (a filter, a range…); a change reloads it. Compared by value: pass an immutable value
    /// (a record of scalars, a tuple…), never an object mutated in place.
    /// </summary>
    [Parameter] public object? ReloadKey { get; set; }

    /// <summary>
    /// Where the component currently is in the load cycle. Whether loaded content is empty is checked on every
    /// render, so content that changes after its load (e.g. live rows laid over it) can leave or enter the empty state.
    /// </summary>
    public AsyncLoadState State =>
        _state == AsyncLoadState.Content && (_value is null || (IsEmpty?.Invoke(_value) ?? false)) ? AsyncLoadState.Empty : _state;

    /// <summary>Whether the content on screen is what is asked for, but from before a failed refresh.</summary>
    public bool IsStale => _stale && State is AsyncLoadState.Content or AsyncLoadState.Empty && Equals(Requested, _shown);

    private AsyncLoadState _state = AsyncLoadState.Loading;

    private TItem? _value;
    private string? _invalidMessage;
    private bool _refreshing;
    private CancellationTokenSource? _cts;
    private bool _started;
    private bool _stale;
    // What the last load was started with (a parameter change reloads), and what the content on screen was loaded
    // with (a failed refresh of the same data keeps it).
    private LoadInput? _requested;
    private LoadInput? _shown;

    private LoadInput Requested => new(Load, ReloadKey);

    private sealed record LoadInput(Func<CancellationToken, Task<TItem>> Load, object? Key);

    protected override Task OnParametersSetAsync()
    {
        // Before the first load the latest parameters are simply picked up by it.
        if (!_started || Equals(Requested, _requested))
        {
            return Task.CompletedTask;
        }
        return ReloadAsync();
    }

    // Prerendering never runs OnAfterRender, so the backend is only called once, by the interactive circuit.
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return Task.CompletedTask;
        }
        _started = true;
        return ReloadAsync();
    }

    /// <summary>
    /// (Re)runs <see cref="Load"/>. The loading state is only shown when there is no content yet; a refresh of
    /// loaded content keeps it on screen until the new data arrives. Call it on the renderer's dispatcher — from an
    /// event handler, or wrapped in <c>InvokeAsync</c> from elsewhere (e.g. a hub callback).
    /// </summary>
    public async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        var cts = new CancellationTokenSource();
        _cts = cts;
        _requested = Requested;

        if (State is AsyncLoadState.Error or AsyncLoadState.Invalid)
        {
            _state = AsyncLoadState.Loading;
            StateHasChanged();
        }
        else if (ShowRefreshing && !_refreshing && State is AsyncLoadState.Content or AsyncLoadState.Empty)
        {
            _refreshing = true;
            StateHasChanged();
        }

        try
        {
            TItem value = await Load(cts.Token);
            if (cts.IsCancellationRequested)
            {
                return;
            }
            _value = value;
            _shown = _requested;
            _state = AsyncLoadState.Content;
            _stale = false;
        }
        catch (Exception) when (cts.IsCancellationRequested)
        {
            // Superseded by a reload, or the component went away: not a failure.
            return;
        }
        catch (OperationCanceledException)
        {
            // Cancelled by something else, typically the HttpClient timeout: the backend didn't answer in time.
            Logger.LogWarning("Loading {Type} for the dashboard timed out.", typeof(TItem).Name);
            Fail();
        }
        catch (Exception ex) when (InvalidMessage?.Invoke(ex) is { } message)
        {
            Logger.LogInformation("The backend rejected the {Type} request: {Message}", typeof(TItem).Name, message);
            _invalidMessage = message;
            _state = AsyncLoadState.Invalid;
            _stale = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Loading {Type} for the dashboard failed.", typeof(TItem).Name);
            Fail();
        }
        _refreshing = false;
        StateHasChanged();
    }

    // Content of the same data stays (marked stale) rather than being blanked by an error.
    private void Fail()
    {
        if (_state is AsyncLoadState.Content && Equals(_requested, _shown))
        {
            _stale = true;
            return;
        }
        _state = AsyncLoadState.Error;
        _stale = false;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
